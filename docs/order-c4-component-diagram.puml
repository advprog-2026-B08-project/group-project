@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram - Order Module

Person(jastiper, "Jastiper", "Manages order status, views to-do list")
Person(titiper, "Titiper", "Places orders, views active and completed orders")
Person(admin, "Admin", "Monitors and moderates all orders")

System_Ext(catalog_module, "Catalog Module", "Provides product information and stock management")
System_Ext(wallet_module, "Wallet Module", "Handles payment processing and refunds")
System_Ext(auth_module, "Auth Module", "Provides user authentication and authorization")

Container_Boundary(order_module, "Order Module") {
    Component(order_api_controller, "OrderApiController", "Spring REST Controller", "Exposes REST API for order creation, cancellation, rating, and status updates")
    Component(order_web_controller, "OrderWebController", "Spring MVC Controller", "Handles web page requests for order lists, detail views, and checkout")
    
    Component(order_service, "OrderService", "Spring Service", "Core business logic: order checkout, transitions, cancellation, rating")
    
    Component(catalog_adapter, "CatalogStockAdapter", "Spring Component", "Adapter communicating with Catalog for stock reservation")
    Component(wallet_adapter, "WalletPaymentAdapter", "Spring Component", "Adapter communicating with Wallet for payments")
    
    Component(order_repository, "OrderRepository", "Spring Data JPA", "Persists order data")
    Component(status_history_repository, "StatusHistoryRepository", "Spring Data JPA", "Persists status tracking history")
}

ContainerDb(database, "Application Database", "Relational Database", "Stores order and status history data")

Rel(jastiper, order_api_controller, "Updates order status", "JSON/HTTPS")
Rel(titiper, order_api_controller, "Places orders, submits ratings", "JSON/HTTPS")

Rel(jastiper, order_web_controller, "Manages orders via web UI", "HTTPS")
Rel(titiper, order_web_controller, "Browses orders via web UI", "HTTPS")
Rel(admin, order_web_controller, "Monitors orders via admin panel", "HTTPS")

Rel(order_api_controller, order_service, "Delegates business logic")
Rel(order_web_controller, order_service, "Delegates business logic")

Rel(order_web_controller, catalog_module, "Fetches catalog info", "Internal")
Rel(order_web_controller, wallet_module, "Fetches wallet balance", "Internal")
Rel(order_web_controller, auth_module, "Fetches user info", "Internal")
Rel(order_web_controller, status_history_repository, "Reads status history")

Rel(order_service, catalog_adapter, "Delegates stock management")
Rel(order_service, wallet_adapter, "Delegates payment processing")
Rel(order_service, catalog_module, "Propagates product rating", "Internal")
Rel(order_service, auth_module, "Fetches user info", "Internal")

Rel(catalog_adapter, catalog_module, "Reserves/releases stock", "Internal")
Rel(wallet_adapter, wallet_module, "Processes payments/refunds", "Internal")

Rel(order_service, order_repository, "Read/write order data")
Rel(order_service, status_history_repository, "Read/write status history")

Rel(order_repository, database, "Read/write", "JPA / SQL")
Rel(status_history_repository, database, "Read/write", "JPA / SQL")

@enduml
